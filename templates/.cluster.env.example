# Copy to `.cluster.env` and customize for your account.
# This file is local-only and ignored by git.

# SSH host alias from ~/.ssh/config (recommended) or full hostname.
CLUSTER_HOST=betty

# Remote project directory.
# If using ~, keep it unexpanded so ssh resolves it remotely.
CLUSTER_PROJECT=~/prism-ssl/templates

# Optional extra SSH flags.
# Example: SSH_OPTS="-J login.betty.parcc.upenn.edu"
SSH_OPTS=
